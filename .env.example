# ===================================
# S3 Portal Environment Configuration
# ===================================

# DATABASE
# --------
# PostgreSQL connection string (recommended for production)
DATABASE_URL="postgresql://user:password@localhost:5432/s3portal?schema=public"

# Alternative: SQLite for local development/testing
# DATABASE_URL="file:./dev.db"

# Examples for hosted databases:
# Railway: postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb


# AUTHENTICATION
# --------------
# NextAuth secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-key-here-min-32-chars"

# Your application URL
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"


# ENCRYPTION
# ----------
# Encryption key for AWS credentials - MUST be exactly 32 characters
# Generate with: openssl rand -base64 32 | cut -c1-32
ENCRYPTION_KEY="generate-a-32-char-encryption-key"


# APPLICATION
# -----------
# Node environment (development, production, test)
NODE_ENV="development"

# Public URL for the application (used in share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# DOCKER COMPOSE CONFIGURATION (when using Docker)
# -------------------------------------------------
# Database password for Docker PostgreSQL container
DB_PASSWORD="changeme"

# Docker build target (development or production)
BUILD_TARGET="development"

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL="INFO"


# OPTIONAL: RATE LIMITING
# ------------------------
# Upstash Redis for rate limiting (optional)
# Sign up at https://upstash.com
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""


# ===================================
# QUICK SETUP INSTRUCTIONS
# ===================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate secrets:
#    export NEXTAUTH_SECRET=$(openssl rand -base64 32)
#    export ENCRYPTION_KEY=$(openssl rand -base64 32 | cut -c1-32)
#
# 3. Update DATABASE_URL with your database credentials
#
# 4. Update NEXTAUTH_URL and NEXT_PUBLIC_APP_URL with your domain
#
# 5. Run setup:
#    npm install
#    npm run db:push
#    npm run dev
#
# ===================================

